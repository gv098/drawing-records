{
  "name": "drawing-records",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "vite build && node scripts/compress.mjs",
    "start": "node server/index.mjs",
    "preview": "npm start",
    "samples": "node scripts/generate-sample.cjs",
    "samples:fill": "node scripts/prepare-fill-sample.cjs",
    "test": "node --test tests/server.test.mjs tests/playback-timing.test.mjs",
    "test:e2e": "node tests/web.cjs",
    "test:brush": "node tests/brush-preview.cjs",
    "test:finish": "node tests/finish-playback.cjs",
    "test:human": "node tests/human-planning.cjs",
    "test:speed": "node tests/normal-speed.cjs"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  }
}
